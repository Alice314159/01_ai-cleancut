{
  "name": "ai-cleancut-web",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "AI CleanCut 前端工程 — 录制 / 增强 / 复核 三条主路径，桌面端与移动端同源响应式",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "build:app": "tsc -b && vite build --mode app --outDir dist-app",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
