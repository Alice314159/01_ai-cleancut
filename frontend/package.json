{
  "name": "ai-cleancut-web",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "AI CleanCut 前端工程 — 录制 / 增强 / 复核 三条主路径，桌面端与移动端同源响应式",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "build:app": "tsc -b && vite build --mode app --outDir dist-app",
    "preview:app": "npm run build:app && vite preview --outDir dist-app --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1"
  }
}
